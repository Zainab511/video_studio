# ---- AI providers (all optional: users can also paste a key in the web UI) ----
# Which provider is preselected: groq | openai | anthropic | custom
LLM_PROVIDER=groq

GROQ_API_KEY=your_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Any OpenAI-compatible service (OpenRouter, Ollama, Together, LM Studio, ...)
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# Let visitors type their own base URL for the custom provider (default: on locally, off on Render)
# ALLOW_CUSTOM_BASE_URL=1

# ---- Voiceover (optional) ----
PIPER_VOICE=./voices/en_US-lessac-medium.onnx

# ---- Deployment ----
# Require a password (browser login box, any username). REQUIRED when deployed on Render.
# APP_PASSWORD=choose_something_long

# ---- Look ----
# VIDEO_THEME=auto          # auto | mix | midnight | neon | sunrise | forest | blueprint | terminal | clean | ocean
# VIDEO_ANIMATED=1          # 0 = themed still slides (much faster)

# ---- Rendering speed (useful on small servers) ----
# VIDEO_HEIGHT=720
# VIDEO_FPS=10
# VIDEO_PRESET=ultrafast
# MAX_SCENES=8
# MAX_VIDEOS=5
